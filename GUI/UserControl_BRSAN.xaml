<UserControl 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" 
    >
    <UserControl.Background>
            <LinearGradientBrush>
            <GradientStopCollection>
                <GradientStop Offset="0.1" Color="White" />
                <GradientStop Offset="0.5" Color="LightGray" />
                <GradientStop Offset="0.8" Color="White" />
            </GradientStopCollection>
        </LinearGradientBrush>
    </UserControl.Background>
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox Grid.Column="0" Grid.RowSpan="4" Header="Actions"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
            <StackPanel>
                <!--FOS_Versio-->
                <ComboBox
                    x:Name="cb_FOS_Version"
                    Foreground="Red"
                    SelectedIndex="0" 
                    SelectedValuePath="Content"
                    ToolTip="Selcet your FOS-Version"
                    Style="{DynamicResource MainComboBoxStyle}">
                    <ComboBoxItem >FOS 10.x</ComboBoxItem>
                    <ComboBoxItem IsSelected="True">FOS 9.x</ComboBoxItem>
                    <ComboBoxItem >FOS 8.x</ComboBoxItem>
                    <ComboBoxItem >FOS 7.x</ComboBoxItem>
                </ComboBox>
                <!--FOS_BasicSwichInfo-->
                <ToggleButton
                x:Name="btn_FOS_BasicSwitchInfo"
                Style="{DynamicResource MainBtnStyle}"
                Content="Switch Info" 
                ToolTip="Get basic SAN-Switch information"/>                
                <!--FOS_SwitchShow-->
                <ToggleButton
                x:Name="btn_FOS_SwitchShow"
                Style="{DynamicResource MainBtnStyle}"
                Content="Switch Show" 
                ToolTip="Get switch and port status information"/>
                <!--FOS_PortLicenseShow-->
                <ToggleButton
                x:Name="btn_FOS_PortLicenseShow"
                Style="{DynamicResource MainBtnStyle}"
                Content="License/ -Port Show" 
                ToolTip="Get the current license keys and information."/>
                <!--FOS_ZoneDetails-->
                <ToggleButton
                x:Name="btn_FOS_ZoneDetailsShow"
                Style="{DynamicResource MainBtnStyle}"
                Content="Effective Zone Show" 
                ToolTip="Get all Effective zone configuration information"/>
                <!--FOS_SensorShow-->
                <ToggleButton
                x:Name="btn_FOS_SensorShow"
                Style="{DynamicResource MainBtnStyle}"
                Content="Sensor Show" 
                ToolTip="Get the current temperature, fan, and power supply status and readings from sensors located on the switch"/>
                <!--FOS_PortErrorShow-->
                <ToggleButton
                x:Name="btn_FOS_SFPHealthShow"
                Style="{DynamicResource MainBtnStyle}"
                Content="SFP Basic Infos" 
                ToolTip="Get a summary of all SFPs in the switch"/>
                <!--FOS_SFPDetails-->
                <ToggleButton
                x:Name="btn_FOS_PortErrorShow"
                Style="{DynamicResource MainBtnStyle}"
                Content="Port Error Show" 
                ToolTip="Get a port error summary"/>
                <!--FOS_PortBufferShow-->
                <ToggleButton
                x:Name="btn_FOS_PortBufferShow"
                Style="{DynamicResource MainBtnStyle}"
                Content="Port Buffer Show" 
                ToolTip="Get the buffer usage information for a port group or for all port groups in the switch"/>
            </StackPanel>
        </GroupBox>
    </Grid>
    </ScrollViewer>
</UserControl>