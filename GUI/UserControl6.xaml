<UserControl 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" 
    >
    <UserControl.Background>
        <LinearGradientBrush>
            <GradientStopCollection>
                <GradientStop Offset="0.1" Color="White" />
                <GradientStop Offset="0.5" Color="LightGray" />
                <GradientStop Offset="0.8" Color="White" />
            </GradientStopCollection>
        </LinearGradientBrush>
    </UserControl.Background>
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- ScrollViewer can be enabeld to auto if needed -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="Options" MinWidth="400" Margin="10,10,10,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid>
                <WrapPanel>
                    <Button x:Name="BTN_HMCCollector" Content="No Creds" Style="{DynamicResource MainBtnStyle}" ToolTipService.InitialShowDelay="10" Visibility="Collapsed">
                        <Button.ToolTip>
                            <ToolTip>
                                <TextBlock x:Name="BTN_HMCCollectorTooltip" Text="Only works in conjunction with the PRISMTool"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <CheckBox x:Name="CB_PowerBoardHMC" Content="View HMC" IsChecked="True" Margin="10,7,0,2" />
                    <CheckBox x:Name="CB_PowerBoardSys" Content="View PowerServer" IsChecked="True" Margin="10,7,0,2" />
                    <CheckBox x:Name="CB_PowerBoardLPAR" Content="View LPAR" IsChecked="True" Margin="10,7,0,2" />
                </WrapPanel>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="HMC Info" MinWidth="820" HorizontalAlignment="Left" Margin="10,10,0,0"  VerticalAlignment="Top" Visibility="{Binding ElementName=CB_PowerBoardHMC, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IC_IBMPowerHMCObjView">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource DashBoardBTNStyle}" Margin="0,5,5,5" MaxWidth="500" IsEnabled="True" ToolTipService.InitialShowDelay="10">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MaxHeight="150"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MaxWidth="70" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.RowSpan="6" Width="65" Height="65" Fill="WhiteSmoke" Stretch="Uniform" >
                                            <Ellipse.Effect>
                                                <DropShadowEffect Direction="320" ShadowDepth="2" Color="LightBlue" BlurRadius="5" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse Grid.RowSpan="6" Width="60" Height="60" >
                                           <Ellipse.Fill>
                                               <ImageBrush ImageSource = "{Binding STOIcon , Mode=TwoWay}" Stretch="Uniform" />
                                           </Ellipse.Fill>
                                        </Ellipse>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="Name:" 
                                                        Margin="3,0"/>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding HMCName}"
                                                        Margin="0"/>
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="MTM:" 
                                                        Margin="3,0"/>
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Grid.Column="2"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding HMCProdMTM}"
                                                        Margin="0"/>
                                                    <TextBlock
                                                        Grid.Row="3"
                                                        Grid.Column="1"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="SN:" 
                                                        Margin="3,0"/>
                                                    <TextBlock
                                                        Grid.Row="3"
                                                        Grid.Column="2"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding HMCSerialNumber}"
                                                        Margin="0"/>
                                                    <TextBlock
                                                        Grid.Row="4"
                                                        Grid.Column="1"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="SW Version:" 
                                                        Margin="3,0"/>
                                                    <TextBlock
                                                        Grid.Row="4"
                                                        Grid.Column="2"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding HMCSWVersion}"
                                                        Margin="0"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="Last Changes">
                                            <Image Source = "{Binding ClockIcon96 , Mode=TwoWay}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxHeight="30" />
                                            <TextBlock Text="{Binding TimeStamp}" HorizontalAlignment="Right" Margin="5,2" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Power Info" MinWidth="820" HorizontalAlignment="Left" Margin="10,10,0,0"  VerticalAlignment="Top" Visibility="{Binding ElementName=CB_PowerBoardSys, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IC_IBMPowerSysObjView">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource DashBoardBTNStyle}" Margin="0,5,5,5" MaxWidth="500" IsEnabled="True" ToolTipService.InitialShowDelay="10">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MaxHeight="150"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MaxWidth="70" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.RowSpan="6" Width="65" Height="65" Fill="WhiteSmoke" Stretch="Uniform" >
                                            <Ellipse.Effect>
                                                <DropShadowEffect Direction="320" ShadowDepth="2" Color="LightBlue" BlurRadius="5" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse Grid.RowSpan="6" Width="60" Height="60" >
                                           <Ellipse.Fill>
                                               <ImageBrush ImageSource = "{Binding STOIcon , Mode=TwoWay}" Stretch="Uniform" />
                                           </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="Name:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding PWRSYSName}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="Status:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            FontSize="12"
                                            Text="{Binding PWRSYSStatus}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property ="Text" Value="Power Off">
                                                            <Setter Property= "Foreground" Value="Red"/>
                                                        </Trigger>
                                                        <Trigger Property ="Text" Value="Operating">
                                                            <Setter Property= "Foreground" Value="green"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="MTM:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding PWRSYSProdMTM}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="SN:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding PWRSYSSerialNumber}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="EC Version:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding PWRSYSECNumber}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="IPL Activated:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding PWRSYSIPLActivatedLevel}"
                                            Margin="0"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="Last Changes">
                                            <Image Source = "{Binding ClockIcon96 , Mode=TwoWay}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxHeight="30" />
                                            <TextBlock Text="{Binding TimeStamp}" HorizontalAlignment="Right" Margin="5,2" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
        <GroupBox Grid.Row="3" Header="LPAR Info" MinWidth="820" HorizontalAlignment="Left" Margin="10,10,0,0"  VerticalAlignment="Top" Visibility="{Binding ElementName=CB_PowerBoardLPAR, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IC_IBMPowerLPARObjView">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource DashBoardBTNStyle}" Margin="0,5,5,5" MaxWidth="500" IsEnabled="True" ToolTipService.InitialShowDelay="10">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MaxHeight="150"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MaxWidth="70" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.RowSpan="6" Width="65" Height="65" Fill="WhiteSmoke" Stretch="Uniform" >
                                            <Ellipse.Effect>
                                                <DropShadowEffect Direction="320" ShadowDepth="2" Color="LightBlue" BlurRadius="5" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse Grid.RowSpan="6" Width="60" Height="60" >
                                           <Ellipse.Fill>
                                               <ImageBrush ImageSource = "{Binding STOIcon , Mode=TwoWay}" Stretch="Uniform" />
                                           </Ellipse.Fill>
                                        </Ellipse>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="Name:" 
                                                        Margin="3,0"/>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding LPARName}"
                                                        Margin="0"/>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="Status:" 
                                                        Margin="3,0"/>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="2"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding LPARStatus}"
                                                        Margin="0"/>
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="Environment:" 
                                                        Margin="3,0"/>
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Grid.Column="2"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding LPAREnvironment}"
                                                        Margin="0"/>
                                                    <TextBlock
                                                        Grid.Row="3"
                                                        Grid.Column="1"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="OS Version:" 
                                                        Margin="3,0"/>
                                                    <TextBlock
                                                        Grid.Row="3"
                                                        Grid.Column="2"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding LPAROSVersion}"
                                                        Margin="0"/>
                                                    <TextBlock
                                                        Grid.Row="4"
                                                        Grid.Column="1"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="LPAR RMC IP:" 
                                                        Margin="3,0"/>
                                                    <TextBlock
                                                        Grid.Row="4"
                                                        Grid.Column="2"
                                                        Style="{DynamicResource DashBoardTB1}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding LPARRMCIP}"
                                                        Margin="0"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="Last Changes">
                                            <Image Source = "{Binding ClockIcon96 , Mode=TwoWay}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxHeight="30" />
                                            <TextBlock Text="{Binding TimeStamp}" HorizontalAlignment="Right" Margin="5,2" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
    </ScrollViewer>
</UserControl>