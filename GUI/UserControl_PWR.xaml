<UserControl x:Name="PWR"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" 
    >
    <!-- Power Board View -->
    <UserControl.Background>
        <LinearGradientBrush>
            <GradientStopCollection>
                <GradientStop Offset="0.1" Color="White" />
                <GradientStop Offset="0.5" Color="LightGray" />
                <GradientStop Offset="0.8" Color="White" />
            </GradientStopCollection>
        </LinearGradientBrush>
    </UserControl.Background>
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- ScrollViewer can be enabeld to auto if needed -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox Grid.Column="0" Grid.RowSpan="4" Header="Actions" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
            <StackPanel>
                <!--PWR_HMCInfo-->
                <ToggleButton
                x:Name="BTN_PWR_HMCInfo"
                Style="{DynamicResource MainBtnStyle}"
                Content="HMC Info" 
                ToolTip="Get Hardware Management Console (HMC) information"/>
                <!--PWR_ManagedSystemInfo-->
                <ToggleButton
                x:Name="BTN_PWR_ManagedSystemInfo"
                Style="{DynamicResource MainBtnStyle}"
                Content="Managed System Info" 
                ToolTip="Get basic Managed System information"/>
                <!--PWR_LparSummary-->
                <ToggleButton
                x:Name="BTN_PWR_LparSummary"
                Style="{DynamicResource MainBtnStyle}"
                Content="Partitions" 
                ToolTip="Get Logical Partition and Virtual I/O Server information"/>
                <!--PWR_LparSummary-->
                <ToggleButton
                x:Name="BTN_PWR_ShowAll"
                Style="{DynamicResource MainBtnStyle}"
                Margin="0,20,0,0"
                Content="Show All Infos" 
                ToolTip="Show All Infos of the System"/>
            </StackPanel>
        </GroupBox>
        <WrapPanel Grid.Column="1" Grid.Row="0" >
            <GroupBox Header="Visibility" Margin="10" >
                <WrapPanel Orientation="Horizontal" ToolTip="klick for visibility" >
                    <!-- Dynamische Checkboxen -->
                    <ItemsControl ItemsSource="{Binding Main.DeviceToggles}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
    
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox Content="{Binding Label}"
                                    IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{DynamicResource MainCheckBoxStyle}"
                                    Margin="2"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
    
                    <!-- Select All -->
                    <CheckBox x:Name="CB_SelectAllSTOCB"
                              Content="Select All"
                              IsChecked="{Binding Main.SelectAll, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="30,2,2,2"
                              Style="{DynamicResource MainCheckBoxStyle}"
                              HorizontalAlignment="Right"/>
                </WrapPanel>
            </GroupBox>
            <GroupBox x:Name="GB_SearchFilterPWR" Header="Filter / Search" Margin="10">
                <DockPanel>
                    <Label Content="Search:" Margin="0,0,6,0" VerticalAlignment="Center" Style="{DynamicResource MainLabelStyle}"/>
                    <TextBox x:Name="TB_GlobalGridSearch"
                        Width="300"
                        Tag="Global Search"
                        ToolTip="Sucht über alle geladenen DataGrids und alle Row-Properties"
                        Style="{DynamicResource TBAZWaterMarkStyle}"/>
                    <ToggleButton x:Name="BTN_GlobalGridSearch"
                        Style="{DynamicResource MainBtnStyle}"
                        Content="Search"
                        Width="80"
                        Margin="6,0,0,0"/>
                    <ToggleButton x:Name="BTN_GlobalGridSearchClear"
                        Style="{DynamicResource MainBtnStyle}"
                        Content="X"
                        Width="30"
                        Margin="6,0,0,0"/>
                </DockPanel>
            </GroupBox>
        </WrapPanel>
        <WrapPanel Orientation="Vertical" Grid.Column="1" Grid.Row="1">
        <!-- PWR_HMCInfo -->
        <GroupBox x:Name="GBPWRHMCInfo" Visibility="Collapsed" Grid.Column="1" Grid.Row="1" Header="HMC Info" MinWidth="320" HorizontalAlignment="Left" Margin="10,10,0,0"  VerticalAlignment="Top" >
            <!-- <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto"> -->
            <WrapPanel>
            <ItemsControl 
                          ItemsSource="{Binding Main.DeviceToggles}"
                          Style="{DynamicResource ShowWhenHMC}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- Ebene 2: echte HMC-Daten (HmcRows) -->
                        <ItemsControl ItemsSource="{Binding HmcRows}"
                                      Visibility="{Binding IsChecked,
                                                           Converter={StaticResource BooleanToVisibilityConverter},
                                                           FallbackValue=Collapsed}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!-- ausblenden wenn keine Items -->
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>

                            <!-- Button pro HMC Row -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource DashBoardBTNStyle}"
                                            Margin="0,5,5,5"
                                            MaxWidth="400"
                                            ToolTipService.InitialShowDelay="10">

                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition MaxHeight="150"/>
                                                <RowDefinition Height="20"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MaxWidth="70" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>

                                                <!-- Falls deine Row ein Icon hat: -->
                                                 <Ellipse Grid.RowSpan="6" Width="60" Height="60">
                                                    <Ellipse.Fill>
                                                        <ImageBrush 
                                                            ImageSource="{Binding DataContext.HMCIcon, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            Stretch="Uniform" />
                                                    </Ellipse.Fill>
                                                </Ellipse>

                                                <TextBlock Grid.Column="1" Style="{DynamicResource DashBoardTB1}"
                                                           VerticalAlignment="Center" Text="Name:" Margin="3,0"/>
                                                <TextBlock Grid.Column="2" Style="{DynamicResource DashBoardTB1}"
                                                           VerticalAlignment="Center" Text="{Binding HmcName}" />

                                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{DynamicResource DashBoardTB1}"
                                                           VerticalAlignment="Center" Text="MTM:" Margin="3,0"/>
                                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{DynamicResource DashBoardTB1}"
                                                           VerticalAlignment="Center" Text="{Binding MachineType}" />

                                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{DynamicResource DashBoardTB1}"
                                                           VerticalAlignment="Center" Text="SN:" Margin="3,0"/>
                                                <TextBlock Grid.Row="4" Grid.Column="2" Style="{DynamicResource DashBoardTB1}"
                                                           VerticalAlignment="Center" Text="{Binding SerialNumber}" />

                                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{DynamicResource DashBoardTB1}"
                                                           VerticalAlignment="Center" Text="SW:" Margin="3,0"/>
                                                <TextBlock Grid.Row="5" Grid.Column="2" Style="{DynamicResource DashBoardTB1}"
                                                           VerticalAlignment="Center" Text="{Binding DisplayVersion}" />

                                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{DynamicResource DashBoardTB1}"
                                                           VerticalAlignment="Center" Text="MS Count:" Margin="3,0"/>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{DynamicResource DashBoardTB1}"
                                                           VerticalAlignment="Center" Text="{Binding ManagedSystemCount}" />
                                            </Grid>

                                            <!-- optional: Timestamp etc. wenn vorhanden -->
                                            <Grid Grid.Row="1">
                                                <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="Last Changes">
                                                    <Image Source="{Binding DataContext.ClockIcon96, RelativeSource={RelativeSource AncestorType=UserControl}}" MaxHeight="30" />
                                                    <TextBlock Text="20260215 17:12" Margin="5,2" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                <ItemsControl x:Name="IC_IBMPowerHMCDBView">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource DashBoardBTNStyle}" Margin="0,5,5,5" MaxWidth="500" IsEnabled="True" ToolTipService.InitialShowDelay="10">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MaxHeight="150"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MaxWidth="90" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.RowSpan="6" Width="65" Height="65" Fill="WhiteSmoke" Stretch="Uniform" Margin="5,0,10,0" >
                                            <Ellipse.Effect>
                                                <DropShadowEffect Direction="320" ShadowDepth="2" Color="LightBlue" BlurRadius="5" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse Grid.RowSpan="6" Width="60" Height="60" Margin="5,0,10,0">
                                           <Ellipse.Fill>
                                               <ImageBrush ImageSource = "{Binding DataContext.HMCIcon, RelativeSource={RelativeSource AncestorType=UserControl}}" Stretch="Uniform" />
                                           </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="Name:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding HMCName}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="System Count:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding ManagedSystemCount}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="MTM:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding HMCMTM}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="SN:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding SerialNumber}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="Version:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding DisplayVersion}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="BIOS:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding BIOS}"
                                            Margin="0"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="Last Changes">
                                            <Image Source = "{Binding DataContext.ClockIcon96, RelativeSource={RelativeSource AncestorType=UserControl}}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxHeight="30" />
                                            <TextBlock Text="{Binding TimeStamp}" HorizontalAlignment="Right" Margin="5,2" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </WrapPanel>
            <!-- </ScrollViewer> -->
        </GroupBox>
        <!-- PWR_ManagedSystemInfo -->
        <GroupBox x:Name="GBPWRManagSysInfo" Visibility="Collapsed" Grid.Column="1" Grid.Row="1" Header="Power System Info" MinWidth="820" MaxWidth="1600" HorizontalAlignment="Left" Margin="10,10,0,0"  VerticalAlignment="Top">
            <WrapPanel>
            <ItemsControl 
                          ItemsSource="{Binding Main.DeviceToggles}"
                          Style="{DynamicResource ShowWhenManagedSystem}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- Ebene 2: echte ManagedSystem-Daten (HmcRows) -->
                        <ItemsControl ItemsSource="{Binding ManagedSystemRows}"
                                      Visibility="{Binding IsChecked,
                                                           Converter={StaticResource BooleanToVisibilityConverter},
                                                           FallbackValue=Collapsed}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!-- ausblenden wenn keine Items -->
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>

                            <!-- Button pro ManagedSystem Row -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource DashBoardBTNStyle}"
                                            Margin="0,5,5,5"
                                            MaxWidth="400"
                                            ToolTipService.InitialShowDelay="10">

                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition MaxHeight="150"/>
                                                <RowDefinition Height="20"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MaxWidth="70" />
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.RowSpan="6" Width="65" Height="65" Fill="WhiteSmoke" Stretch="Uniform" >
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Direction="320" ShadowDepth="2" Color="LightBlue" BlurRadius="5" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <Ellipse Grid.RowSpan="6" Width="60" Height="60" >
                                                   <Ellipse.Fill> 
                                                       <ImageBrush ImageSource = "{Binding DataContext.PowerIcon, RelativeSource={RelativeSource AncestorType=UserControl}}" Stretch="Uniform" />
                                                   </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="Name:" 
                                                    Margin="3,0"/>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding SystemName}"
                                                    Margin="0"/>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="Status:" 
                                                    Margin="3,0"/>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    FontSize="12"
                                                    Text="{Binding State}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <Trigger Property ="Text" Value="power off">
                                                                    <Setter Property= "Foreground" Value="Red"/>
                                                                </Trigger>
                                                                <Trigger Property ="Text" Value="operating">
                                                                    <Setter Property= "Foreground" Value="green"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="MTM:" 
                                                    Margin="3,0"/>
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="2"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding MachineTypeModel}"
                                                    Margin="0"/>
                                                <TextBlock
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="SN:" 
                                                    Margin="3,0"/>
                                                <TextBlock
                                                    Grid.Row="3"
                                                    Grid.Column="2"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding SerialNumber}"
                                                    Margin="0"/>
                                                <TextBlock
                                                    Grid.Row="4"
                                                    Grid.Column="1"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="EC Version:" 
                                                    Margin="3,0"/>
                                                <TextBlock
                                                    Grid.Row="4"
                                                    Grid.Column="2"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding ECNumber}"
                                                    Margin="0"/>
                                                <TextBlock
                                                    Grid.Row="5"
                                                    Grid.Column="1"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="IPL Activated:" 
                                                    Margin="3,0"/>
                                                <TextBlock
                                                    Grid.Row="5"
                                                    Grid.Column="2"
                                                    Style="{DynamicResource DashBoardTB1}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding ActivatedLevel}"
                                                    Margin="0"/>
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="Last Changes">
                                                    <Image Source="{Binding DataContext.ClockIcon96, RelativeSource={RelativeSource AncestorType=UserControl}}" MaxHeight="30" />
                                                    <TextBlock Text="20260215 17:12" Margin="5,2" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                <ItemsControl x:Name="IC_IBMPowerSysDBView">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource DashBoardBTNStyle}" Margin="0,5,5,5" MaxWidth="500" IsEnabled="True" ToolTipService.InitialShowDelay="10">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MaxHeight="150"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MaxWidth="90" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.RowSpan="6" Width="65" Height="65" Fill="WhiteSmoke" Stretch="Uniform" Margin="5,0,10,0" >
                                            <Ellipse.Effect>
                                                <DropShadowEffect Direction="320" ShadowDepth="2" Color="LightBlue" BlurRadius="5" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse Grid.RowSpan="6" Width="60" Height="60" Margin="5,0,10,0">
                                           <Ellipse.Fill>
                                               <ImageBrush ImageSource = "{Binding DataContext.PowerIcon, RelativeSource={RelativeSource AncestorType=UserControl}}" Stretch="Uniform" />
                                           </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="Name:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding SystemName}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="Status:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            FontSize="14"
                                            Text="{Binding State}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property ="Text" Value="Power Off">
                                                            <Setter Property= "Foreground" Value="Red"/>
                                                        </Trigger>
                                                        <Trigger Property ="Text" Value="operating">
                                                            <Setter Property= "Foreground" Value="Green"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="MTM:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding MachineTypeModel}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="SN:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding SerialNumber}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="EC Version:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding ECNumber}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="IPL Activated:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding ActivatedLevel}"
                                            Margin="0"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="Last Changes">
                                            <Image Source = "{Binding DataContext.ClockIcon96, RelativeSource={RelativeSource AncestorType=UserControl}}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxHeight="30" />
                                            <TextBlock Text="{Binding TimeStamp}" HorizontalAlignment="Right" Margin="5,2" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </WrapPanel>
        </GroupBox>
        <!-- PWR_LparSummary -->
        <GroupBox x:Name="GBPWRLPARSum" Visibility="Collapsed" Grid.Column="1" Grid.Row="1" Header="Partition Info" MinWidth="820" MaxWidth="1600" MaxHeight="800" HorizontalAlignment="Left" Margin="10,10,0,0"  VerticalAlignment="Top" >
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl
                    ItemsSource="{Binding Main.DeviceToggles}"
                    Style="{DynamicResource ShowWhenLPAR}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Margin="5"
                                Visibility="{Binding IsChecked,
                                    Converter={StaticResource BooleanToVisibilityConverter},
                                    FallbackValue=Collapsed}">
                                <!-- Is that really necessary?
                                <TextBlock
                                    Text="{Binding DeviceTitle}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Margin="0,0,0,5"/>
                                    -->

                                <DataGrid
                                    ItemsSource="{Binding LparRows}"
                                    AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    CanUserSortColumns="True"
                                    CanUserResizeColumns="True"
                                    SelectionMode="Single"
                                    SelectionUnit="FullRow"
                                    HeadersVisibility="Column"
                                    GridLinesVisibility="Horizontal"
                                    RowHeaderWidth="0"
                                    MaxHeight="500"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto"
                                    AlternatingRowBackground="WhiteSmoke">

                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding PartitionRole}"
                                                    Value="VIOS">
                                                    <Setter Property="Background" Value="LightBlue"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding State}"
                                                    Value="not activated">
                                                    <Setter Property="Foreground" Value="DarkGoldenrod"/>
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding State}"
                                                    Value="not available">
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.Columns>

                                        <DataGridTextColumn
                                            Header="Managed System"
                                            Binding="{Binding ManagedSystemName}"
                                            Width="220"/>

                                        <DataGridTextColumn
                                            Header="Partition"
                                            Binding="{Binding LparName}"
                                            Width="220"/>

                                        <DataGridTextColumn
                                            Header="Type"
                                            Binding="{Binding PartitionRole}"
                                            Width="70"/>

                                        <DataGridTextColumn
                                            Header="ID"
                                            Binding="{Binding PartitionId}"
                                            Width="50"/>

                                        <DataGridTextColumn
                                            Header="State"
                                            Binding="{Binding State}"
                                            Width="105"/>

                                        <DataGridTextColumn
                                            Header="Environment"
                                            Binding="{Binding Environment}"
                                            Width="95"/>

                                        <DataGridTextColumn
                                            Header="OS Version"
                                            Binding="{Binding OsVersion}"
                                            Width="260"/>

                                        <DataGridTextColumn
                                            Header="RMC State"
                                            Binding="{Binding RmcState}"
                                            Width="90"/>

                                        <DataGridTextColumn
                                            Header="RMC IP"
                                            Binding="{Binding RmcIp}"
                                            Width="120"/>

                                        <DataGridTextColumn
                                            Header="CPU"
                                            Binding="{Binding CurrentProcessingUnits}"
                                            Width="65"/>

                                        <DataGridTextColumn
                                            Header="Memory MB"
                                            Binding="{Binding CurrentMemoryMB}"
                                            Width="90"/>

                                        <DataGridTextColumn
                                            Header="Profile"
                                            Binding="{Binding DefaultProfile}"
                                            Width="150"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </StackPanel>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>
        </GroupBox>
        </WrapPanel>
    </Grid>
    </ScrollViewer>
</UserControl>