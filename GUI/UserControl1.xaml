                                                Grid.Column="1"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="HostName:" 
                                                Margin="8,0,5,0"/>
                                            <TextBlock
                                                Grid.Column="2"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{Binding Name}"/>
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="HostClusterName:" 
                                                Margin="8,0,5,0"/>
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{Binding HostClusterName}"/>
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="Status:" 
                                                Margin="8,0,5,0"/>
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Margin="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                FontSize="12"
                                                Text="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property ="Text" Value="offline">
                                                                <Setter Property= "Foreground" Value="Red"/>
                                                            </Trigger>
                                                            <Trigger Property ="Text" Value="degraded">
                                                                <Setter Property= "Foreground" Value="Orange"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                </TextBlock>
                                            <TextBlock
