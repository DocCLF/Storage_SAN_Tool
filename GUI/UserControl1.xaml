                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{Binding STOName}"/>
                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
