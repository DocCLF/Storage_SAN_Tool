<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" 
    >
    <UserControl.Background>
        <LinearGradientBrush>
            <GradientStopCollection>
                <GradientStop Offset="0.1" Color="White" />
                <GradientStop Offset="0.5" Color="LightGray" />
                <GradientStop Offset="0.8" Color="White" />
            </GradientStopCollection>
        </LinearGradientBrush>
    </UserControl.Background>
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- ScrollViewer can be enabeld to auto if needed -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        
        <GroupBox Grid.Row="0" Header="Overview" MinWidth="400" Margin="10,10,10,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid>
                <WrapPanel>
                    <Label MinWidth="150" Margin="5">
                        <StackPanel Width="150">
                            <TextBlock Text="Overall Status" FontWeight="Bold" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TB_HealthStatus" Text="Health OK" Foreground="Green" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Button x:name="BTN_RefreshUC1" Height="50" Width="50" HorizontalAlignment="center" Background="Transparent" BorderThickness="0" >
                                <Image Source = "{Binding RefrehIcon96 , Mode=TwoWay}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxHeight="30" />
                            </Button>
                        </StackPanel>
                    </Label>
                    <Label MinWidth="150" Margin="0">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Text="Storage Devices:" FontWeight="Bold" HorizontalAlignment="Left" Padding="5"/>
                            <TextBlock x:Name="TB_STODEVCount" Grid.Row="0" Grid.Column="1" Text="0" Foreground="Green" FontWeight="Bold" Padding="5"/>
                            <TextBlock Grid.Row="1" Text="Events:" FontWeight="Bold" HorizontalAlignment="Left" Padding="5"/>
                            <TextBlock x:Name="TB_STOEventsCount" Grid.Row="1" Grid.Column="1" Text="0" Foreground="Green" FontWeight="Bold" Padding="5"/>
                            <TextBlock Grid.Row="2" Text="SAN Devices:" FontWeight="Bold" HorizontalAlignment="Left" Padding="5"/>
                            <TextBlock x:Name="TB_SANDEVCount" Grid.Row="2" Grid.Column="1" Text="0" Foreground="Green" FontWeight="Bold" Padding="5"/>
                            <TextBlock Grid.Row="3" Text="Events:" FontWeight="Bold" HorizontalAlignment="Left" Padding="5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="0" Foreground="Green" FontWeight="Bold" Padding="5"/>
                        </Grid>
                    </Label>
                    <Label MinWidth="150" Margin="0">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Text="Host Devices:" FontWeight="Bold" HorizontalAlignment="Left" Padding="5"/>
                            <TextBlock x:Name="TB_ALLHostCount" Grid.Row="0" Grid.Column="1" Text="0" Foreground="Green" FontWeight="Bold" Padding="5"/>
                            <TextBlock Grid.Row="1" Text="Events:" FontWeight="Bold" HorizontalAlignment="Left" Padding="5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="0" Foreground="Green" FontWeight="Bold" Padding="5"/>
                            <TextBlock Grid.Row="2" Text="Online Hosts:" FontWeight="Bold" HorizontalAlignment="Left" Padding="5"/>
                            <TextBlock x:Name="TB_OnlinelHostCount" Grid.Row="2" Grid.Column="1" Text="0" Foreground="Green" FontWeight="Bold" Padding="5"/>
                            <TextBlock Grid.Row="3" Text="Offline Hosts:" FontWeight="Bold" HorizontalAlignment="Left" Padding="5"/>
                            <TextBlock x:Name="TB_OfflHostCount" Grid.Row="3" Grid.Column="1" Text="0" Foreground="red" FontWeight="Bold" Padding="5"/>
                        </Grid>                        
                    </Label>
                    <Label MinWidth="150" Margin="0" >
                        <Grid>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" Margin="5">
                                <TextBlock Text="DriveFW / Latest DriveFW" FontWeight="Bold" HorizontalAlignment="left" />
                                <TextBlock x:Name="TB_NKNResOne" Text=""  HorizontalAlignment="left" Visibility = "Collapsed" Margin="2"/>
                                <TextBlock x:Name="TB_NKNResTwo" Text="" HorizontalAlignment="left" Visibility = "Collapsed" Margin="2"/>
                                <TextBlock x:Name="TB_NKNResThree" Text="" HorizontalAlignment="left" Visibility = "Collapsed" Margin="2"/>
                            </StackPanel>
                        </Grid>
                    </Label>
                </WrapPanel>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Storage Info" MinWidth="400" MaxHeight="340" HorizontalAlignment="Left" Margin="10,10,0,0"  VerticalAlignment="Top">
            <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IC_DashBoardSTODevice">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource DashBoardBTNStyle}" Margin="0,5,5,5" Width="300" IsEnabled="True">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MaxHeight="150"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MaxWidth="70" />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.RowSpan="6" Width="65" Height="65" Fill="WhiteSmoke" Stretch="Uniform" >
                                            <Ellipse.Effect>
                                                <DropShadowEffect Direction="320" ShadowDepth="2" Color="LightBlue" BlurRadius="5" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse Grid.RowSpan="6" Width="60" Height="60" >
                                           <Ellipse.Fill>
                                               <ImageBrush ImageSource = "{Binding STOIcon , Mode=TwoWay}" Stretch="Uniform" />
                                           </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="ClusterName:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding ClusterName}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="Status:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding Status}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="MTM:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding ProdMTM}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="SN:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding SerialNumber}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="FW:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding CodeLevel}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="FW Rec:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding RecommendedPTF}"
                                            Margin="0"/>
                                        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="5,0">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="0" />
                                                <TextBlock Text="{Binding MDiskTC}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Height="5" BorderBrush="WhiteSmoke" Foreground="Teal" Maximum="{Binding MDiskTCfPGB}" Value="{Binding MDiskUC}">
                                                <ProgressBar.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="2" />
                                                    </Style>
                                                </ProgressBar.Resources>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="Last Changes">
                                            <Image Source = "{Binding ClockIcon96 , Mode=TwoWay}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxHeight="30" />
                                            <TextBlock Text="{Binding TimeStamp}" HorizontalAlignment="Right" Margin="5,2" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
        <!--<GroupBox Grid.Row="2" Header="Power Info" MinWidth="820" HorizontalAlignment="Left" Margin="10,10,0,0"  VerticalAlignment="Top">
            <StackPanel Grid.Row="0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="5" Height="150" Background="AliceBlue">
                    <Button x:Name="BTN_PWR_DevOne" Content="" MaxWidth="250" MaxHeight="150" Margin="5" Padding="5"/>
                    <Button x:Name="BTN_PWR_DevTwo" Content="" MaxWidth="250" MaxHeight="150" Margin="5" Padding="5"/>
                    <Button x:Name="BTN_PWR_DevThree" Content="" MaxWidth="250" MaxHeight="150" Margin="5" Padding="5"/>
                    <Button x:Name="BTN_PWR_DevFour" Content="" MaxWidth="250" MaxHeight="150" Margin="5" Padding="5"/>
                    <Button x:Name="BTN_PWR_DevFive" Content="" MaxWidth="250" MaxHeight="150" Margin="5" Padding="5"/>
                    <Button x:Name="BTN_PWR_DevSix" Content="" MaxWidth="250" MaxHeight="150" Margin="5" Padding="5"/>
                    <Button x:Name="BTN_PWR_DevSeven" Content="" MaxWidth="250" MaxHeight="150" Margin="5" Padding="5"/>
                    <Button x:Name="BTN_PWR_DevEight" Content="" MaxWidth="250" MaxHeight="150" Margin="5" Padding="5"/>
                </StackPanel>
            </StackPanel>
        </GroupBox> -->
        <GroupBox Grid.Row="3" Header="SAN Info" MinWidth="400" MaxHeight="340" HorizontalAlignment="Left" Margin="10,10,0,0"  VerticalAlignment="Top">
            <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IC_DashBoardSANDevice">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource DashBoardBTNStyle}" Margin="0,5,5,5" Width="300" IsEnabled="True">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MaxHeight="150"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MaxWidth="70" />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.RowSpan="6" Width="65" Height="65" Fill="WhiteSmoke" Stretch="Uniform" >
                                            <Ellipse.Effect>
                                                <DropShadowEffect Direction="320" ShadowDepth="2" Color="LightBlue" BlurRadius="5" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse Grid.RowSpan="6" Width="60" Height="60" >
                                           <Ellipse.Fill>
                                               <ImageBrush ImageSource = "{Binding BrocadeIcon , Mode=TwoWay}" Stretch="Uniform" />
                                           </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="Name:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="Status:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding Status}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="MTM:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding BrocadeProdName}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="SN:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding SerialNumber}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="FW:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding CodeLevel}"
                                            Margin="0"/>
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="FW Rec:" 
                                            Margin="3,0"/>
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="2"
                                            Style="{DynamicResource DashBoardTB1}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="not yet impl."
                                            Margin="0"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="Last Changes">
                                            <Image Source = "{Binding ClockIcon96 , Mode=TwoWay}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxHeight="30" />
                                            <TextBlock Text="{Binding TimeStamp}" HorizontalAlignment="Right" Margin="5,2" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
        <GroupBox Grid.Row="4" Header="Host Info" MinWidth="400" MaxHeight="260" HorizontalAlignment="Left" Margin="10,10,0,0"  VerticalAlignment="Top">
                <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IC_DashBoardHosts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource DashBoardBTNStyle}" Margin="0,5,5,5" Width="350" IsEnabled="True">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition MaxHeight="100"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition MaxWidth="70" />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.RowSpan="4" Width="45" Height="45" Fill="WhiteSmoke" Stretch="Uniform" >
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Direction="320" ShadowDepth="2" Color="LightBlue" BlurRadius="5" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <Ellipse Grid.RowSpan="4" Width="40" Height="40" >
                                               <Ellipse.Fill>
                                                   <ImageBrush ImageSource = "{Binding HostIcon , Mode=TwoWay}" Stretch="Uniform" />
                                               </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="HostName:" 
                                                Margin="8,0,5,0"/>
                                            <TextBlock
                                                Grid.Column="2"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{Binding Name}"/>
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="HostClusterName:" 
                                                Margin="8,0,5,0"/>
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{Binding HostClusterName}"/>
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="Status:" 
                                                Margin="8,0,5,0"/>
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Margin="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                FontSize="12"
                                                Text="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property ="Text" Value="offline">
                                                                <Setter Property= "Foreground" Value="Red"/>
                                                            </Trigger>
                                                            <Trigger Property ="Text" Value="degraded">
                                                                <Setter Property= "Foreground" Value="Orange"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                </TextBlock>
                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="StorageName:" 
                                                Margin="8,0,0,0"/>
                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{Binding STOName}"/>
                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="SideName:" 
                                                Margin="8,0,0,0"/>
                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="2"
                                                Style="{DynamicResource DashBoardTB2}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{Binding SideName}"/>
                                        </Grid>
                                        <Grid Grid.Row="1">
                                            <StackPanel Orientation="Horizontal" Margin="5,0" ToolTip="Last Changes">
                                                <Image Source = "{Binding ClockIcon96 , Mode=TwoWay}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxHeight="30" />
                                                <TextBlock Text="{Binding TimeStamp}" HorizontalAlignment="Right" Margin="5,2" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
        </GroupBox>
    </Grid>
    </ScrollViewer>
</UserControl>