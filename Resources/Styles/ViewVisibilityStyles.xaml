<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nur sichtbar, wenn Main.SelectedView == Base -->
    <Style x:Key="ShowWhenBase" TargetType="ItemsControl">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Main.SelectedView}" Value="Base">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Nur sichtbar, wenn Main.SelectedView == Events -->
    <Style x:Key="ShowWhenEvents" TargetType="ItemsControl">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Main.SelectedView}" Value="Events">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Nur sichtbar, wenn Main.SelectedView == CatAuditLog -->
