<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nur sichtbar, wenn Main.SelectedView == HMC -->
    <Style x:Key="ShowWhenHMC" TargetType="ItemsControl">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Main.SelectedView}" Value="HMC">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Nur sichtbar, wenn Main.SelectedView == ManagedSystem -->
    <Style x:Key="ShowWhenManagedSystem" TargetType="ItemsControl">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Main.SelectedView}" Value="ManagedSystem">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Nur sichtbar, wenn Main.SelectedView == LPARs -->
    <Style x:Key="ShowWhenLPAR" TargetType="ItemsControl">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Main.SelectedView}" Value="LPARs">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>